<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>FORTUNA CAR — Автомобили из Японии, Кореи и Китая</title>

<style>
:root{
  --bg:#040912;
  --panel:#09111d;
  --panel2:#0c1624;
  --stroke:#18273b;
  --text:#f4f7fc;
  --muted:#8290a3;
  --blue:#238cff;
  --violet:#7045ff;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:
    radial-gradient(
      600px 380px at 77% 13%,
      rgba(20,89,255,.18),
      transparent 70%
    ),
    radial-gradient(
      520px 340px at 48% 75%,
      rgba(72,49,255,.08),
      transparent 70%
    ),
    var(--bg);
  color:var(--text);
  font-family:Inter,Arial,sans-serif;
  font-size:13px;
  overflow-x:hidden;
}

body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  opacity:.12;
  background-image:
    linear-gradient(rgba(90,130,190,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(90,130,190,.06) 1px,transparent 1px);
  background-size:48px 48px;
}

a{
  text-decoration:none;
  color:inherit;
}

.wrap{
  width:min(1190px,calc(100% - 44px));
  margin:auto;
}


/* ================= HEADER ================= */

header{
  height:68px;
  position:fixed;
  z-index:50;
  top:0;
  left:0;
  right:0;
  background:rgba(3,8,15,.82);
  backdrop-filter:blur(18px);
  border-bottom:1px solid transparent;
  transition:.25s;
}

header.scrolled{
  border-color:var(--stroke);
}

nav{
  height:100%;
  display:flex;
  align-items:center;
  gap:30px;
}

.logo{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:120px;
  font-weight:900;
}

.mark{
  width:35px;
  height:27px;
  position:relative;
  transform:skew(-17deg);
}

.mark i{
  position:absolute;
  left:0;
  height:5px;
  border-radius:4px;
  background:linear-gradient(
    90deg,
    #168bff,
    #7655ff
  );
  box-shadow:0 0 10px rgba(50,120,255,.22);
}

.mark i:nth-child(1){
  width:34px;
  top:1px;
}

.mark i:nth-child(2){
  width:25px;
  top:10px;
}

.mark i:nth-child(3){
  width:16px;
  top:19px;
}

.logo b{
  font-size:10px;
  line-height:10px;
  letter-spacing:.11em;
}

.logo b span{
  display:block;
}

.nav{
  display:flex;
  gap:24px;
  flex:1;
  color:#9ba8ba;
  font-size:9px;
}

.nav a{
  transition:.2s;
}

.nav a:hover{
  color:#fff;
}

.tel{
  text-align:right;
  font-size:10px;
  font-weight:800;
  white-space:nowrap;
}

.tel small{
  display:block;
  color:#66758a;
  font-size:7px;
  font-weight:500;
}

.header-cta{
  padding:11px 17px;
  border-radius:9px;
  font-size:9px;
  font-weight:800;
  background:
    linear-gradient(
      110deg,
      #238cff,
      #7042f3
    );
  box-shadow:
    0 0 25px rgba(91,68,255,.22);
}

.burger{
  display:none;
  background:none;
  border:0;
  color:white;
  font-size:23px;
}


/* ================= HERO ================= */

.hero{
  padding:99px 0 13px;
  min-height:555px;
}

.hero-grid{
  display:grid;
  grid-template-columns:43% 57%;
  align-items:center;
}

.kicker{
  color:#78869a;
  font-size:7px;
  letter-spacing:.09em;
  text-transform:uppercase;
  margin-bottom:20px;
}

h1{
  font-size:clamp(38px,4.4vw,57px);
  line-height:1.04;
  letter-spacing:-.05em;
  margin:0;
}

.grad{
  background:
    linear-gradient(
      90deg,
      #4ba7ff 0%,
      #657bff 58%,
      #7956ff 100%
    );
  -webkit-background-clip:text;
  color:transparent;
}

.lead{
  max-width:450px;
  color:#929fb0;
  font-size:10px;
  line-height:1.65;
  margin:17px 0 22px;
}

.actions{
  display:flex;
  gap:10px;
}

.btn{
  padding:13px 17px;
  border-radius:8px;
  font-size:9px;
  font-weight:800;
}

.primary{
  background:
    linear-gradient(
      105deg,
      #258fff,
      #6d43f6
    );
  box-shadow:
    0 0 25px rgba(53,101,255,.24);
}

.secondary{
  background:#08111d;
  border:1px solid var(--stroke);
}

.hero-stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
  margin-top:27px;
  max-width:430px;
}

.stat{
  padding:9px 10px;
  border:1px solid var(--stroke);
  background:rgba(9,18,30,.8);
  border-radius:8px;
}

.stat strong{
  font-size:10px;
  display:block;
}

.stat span{
  font-size:6.5px;
  color:#6f7d91;
}


/* ================= CAR ================= */

.visual{
  height:415px;
  position:relative;
}

.blue-glow{
  position:absolute;
  width:560px;
  height:280px;
  right:-10px;
  bottom:20px;
  background:
    radial-gradient(
      ellipse,
      rgba(0,111,255,.57),
      transparent 66%
    );
  filter:blur(18px);
}

.orbit{
  position:absolute;
  right:-10px;
  top:43px;
  width:500px;
  height:215px;
  border:
    1px solid rgba(47,126,255,.45);
  border-left-color:transparent;
  border-radius:50%;
  transform:rotate(-14deg);
  box-shadow:
    0 0 25px rgba(30,105,255,.14);
}

.orbit:after{
  content:"";
  position:absolute;
  right:79px;
  top:11px;
  width:5px;
  height:5px;
  border-radius:50%;
  background:#59adff;
  box-shadow:0 0 18px #59adff;
}

.hero-car{
  position:absolute;
  width:620px;
  max-width:130%;
  right:-22px;
  bottom:7px;
  z-index:3;
  filter:
    drop-shadow(
      0 30px 28px rgba(0,0,0,.72)
    );
  animation:float 5s ease-in-out infinite;
}

@keyframes float{
  50%{
    transform:translateY(-7px);
  }
}


/* ================= FLOAT CARDS ================= */

.float{
  position:absolute;
  z-index:6;
  border:
    1px solid rgba(103,141,207,.23);
  background:
    rgba(10,21,35,.9);
  backdrop-filter:blur(14px);
  border-radius:15px;
  box-shadow:
    0 22px 42px rgba(0,0,0,.34);
}

.car-card{
  left:0;
  top:5px;
  width:205px;
  padding:14px;
}

.car-card b{
  font-size:10px;
}

.car-card small{
  display:block;
  font-size:7px;
  color:#718095;
  margin-top:4px;
}

.rating{
  margin-top:10px;
  color:#ffc94d;
  font-size:8px;
}

.rating span{
  color:#cbd4e0;
  margin-left:9px;
}

.save{
  right:0;
  top:68px;
  width:153px;
  padding:14px;
}

.save small{
  color:#7d8ba0;
  font-size:7px;
}

.save strong{
  display:block;
  font-size:18px;
  margin:2px 0;
}

.save em{
  font-style:normal;
  color:#6b798d;
  font-size:7px;
}

.route{
  right:55px;
  bottom:0;
  width:181px;
  padding:14px;
}

.route b{
  font-size:9px;
}

.route ul{
  margin:9px 0 0;
  padding-left:14px;
  color:#7d8ba1;
  font-size:7px;
}

.route li{
  margin:4px 0;
}


/* ================= PANELS ================= */

.panel{
  border:
    1px solid var(--stroke);
  border-radius:13px;
  background:
    linear-gradient(
      145deg,
      rgba(10,19,31,.96),
      rgba(6,13,23,.97)
    );
  box-shadow:
    0 18px 48px rgba(0,0,0,.17);
}

section{
  padding:9px 0;
}


/* ================= PARTNERS ================= */

.partners{
  padding:11px 17px;
}

.partners-title{
  font-size:7px;
  color:#7c8a9d;
  margin-bottom:9px;
}

.partner-row{
  display:grid;
  grid-template-columns:repeat(6,1fr);
}

.partner{
  height:34px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-right:1px solid var(--stroke);
  color:#bbc5d3;
  font-weight:900;
  font-size:12px;
  opacity:.72;
}

.partner:last-child{
  border:0;
}


/* ================= FEATURES ================= */

.block{
  padding:17px;
}

.title{
  font-size:18px;
  margin:0 0 13px;
}

.title span{
  color:#678dff;
}

.features{
  padding-bottom:14px;
}

.feature-grid{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:1px;
  background:var(--stroke);
}

.feature{
  background:#0a1320;
  padding:17px 11px;
  min-height:137px;
}

.ico{
  width:31px;
  height:31px;
  display:grid;
  place-items:center;
  border:
    1px solid rgba(66,119,255,.35);
  background:
    rgba(45,101,255,.07);
  border-radius:8px;
  color:#65a0ff;
  margin-bottom:13px;
  font-size:14px;
}

.feature h3{
  font-size:9px;
  margin:0 0 7px;
}

.feature p{
  font-size:7px;
  color:#718096;
  line-height:1.45;
  margin:0;
}


/* ================= STEPS ================= */

.steps{
  padding:17px 20px 14px;
}

.step-grid{
  display:grid;
  grid-template-columns:repeat(7,1fr);
}

.step{
  text-align:center;
  position:relative;
}

.step:not(:last-child):after{
  content:"";
  position:absolute;
  top:19px;
  left:64%;
  width:72%;
  border-top:1px dashed rgba(68,113,239,.52);
}

.step-circle{
  width:39px;
  height:39px;
  margin:auto;
  position:relative;
  z-index:2;
  border:
    1px solid #3b66bd;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#091321;
  color:#68a1ff;
  box-shadow:
    0 0 20px rgba(55,100,255,.13);
  font-size:12px;
}

.step b{
  font-size:8px;
  display:block;
  margin-top:8px;
}

.step p{
  font-size:6.7px;
  color:#6d7b90;
  line-height:1.4;
  max-width:110px;
  margin:4px auto;
}


/* ================= CALCULATOR ================= */

.calc{
  padding:18px;
}

.calc-grid{
  display:grid;
  grid-template-columns:38% 62%;
}

.calc-left{
  padding-right:21px;
}

.calc-left h2{
  font-size:23px;
  line-height:1.08;
  margin:0 0 8px;
}

.calc-left p{
  font-size:7.5px;
  color:#7f8ca0;
  margin:0;
}

.calc-photo{
  height:145px;
  margin-top:10px;
  border-radius:10px;
  overflow:hidden;
  position:relative;

  background:
    url("https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=90")
    center/cover;
}

.calc-photo:after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(6,13,23,.74),
      rgba(6,13,23,.08) 70%
    );
}

.form{
  border-left:1px solid var(--stroke);
  padding-left:20px;
}

.fields{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:9px;
}

.field label{
  display:block;
  color:#748299;
  font-size:7px;
  margin-bottom:5px;
}

.field select,
.field input{
  width:100%;
  padding:10px 8px;
  border:1px solid var(--stroke);
  border-radius:6px;
  background:#091321;
  color:#dce5f1;
  font-size:8px;
  outline:0;
}

.submit{
  grid-column:1/-1;
  border:0;
  border-radius:7px;
  padding:11px;
  color:#fff;
  font-size:8.5px;
  font-weight:800;
  background:
    linear-gradient(
      105deg,
      #258cff,
      #7344f7
    );
  box-shadow:
    0 0 18px rgba(70,77,255,.18);
  cursor:pointer;
}

.form-bottom{
  display:flex;
  justify-content:space-between;
  margin-top:9px;
  color:#617087;
  font-size:6.5px;
}


/* ================= FOOTER ================= */

footer{
  padding:25px 0;
  color:#58667a;
  font-size:7px;
}

.foot{
  border-top:1px solid var(--stroke);
  padding-top:15px;
  display:flex;
  justify-content:space-between;
}


/* ================= ANIMATION ================= */

.reveal{
  opacity:0;
  transform:translateY(16px);
  transition:.65s;
}

.reveal.show{
  opacity:1;
  transform:none;
}


/* ================= TABLET ================= */

@media(max-width:900px){

  .nav,
  .tel,
  .header-cta{
    display:none;
  }

  .burger{
    display:block;
    margin-left:auto;
  }

  .hero{
    padding-top:95px;
  }

  .hero-grid{
    grid-template-columns:1fr;
  }

  .visual{
    height:385px;
  }

  .hero-car{
    right:50%;
    transform:translateX(50%);
    max-width:125%;
  }

  .feature-grid{
    grid-template-columns:repeat(3,1fr);
  }

  .step-grid{
    grid-template-columns:repeat(4,1fr);
    gap:25px 0;
  }

  .step:after{
    display:none;
  }

  .calc-grid{
    grid-template-columns:1fr;
  }

  .form{
    border-left:0;
    border-top:1px solid var(--stroke);
    padding:18px 0 0;
    margin-top:18px;
  }

  .calc-left{
    padding:0;
  }

  .partner-row{
    grid-template-columns:repeat(3,1fr);
  }
}


/* ================= PHONE ================= */

@media(max-width:600px){

  .wrap{
    width:calc(100% - 24px);
  }

  header{
    height:62px;
  }

  .hero{
    padding-top:86px;
  }

  .kicker{
    font-size:6.5px;
    margin-bottom:14px;
  }

  h1{
    font-size:38px;
  }

  .lead{
    font-size:9px;
  }

  .actions{
    flex-direction:column;
  }

  .actions .btn{
    text-align:center;
  }

  .hero-stats{
    grid-template-columns:1fr 1fr;
    max-width:none;
  }

  .visual{
    height:305px;
  }

  .hero-car{
    width:530px;
    max-width:145%;
  }

  .orbit{
    width:365px;
    height:160px;
    right:-32px;
    top:42px;
  }

  .car-card{
    width:155px;
    padding:11px;
  }

  .save{
    width:115px;
    top:58px;
    padding:11px;
  }

  .save strong{
    font-size:15px;
  }

  .route{
    width:145px;
    right:3px;
    padding:10px;
  }

  .partner{
    font-size:10px;
    height:32px;
  }

  .block{
    padding:12px;
  }

  .feature-grid{
    grid-template-columns:1fr 1fr;
  }

  .feature{
    min-height:128px;
  }

  .steps{
    padding:14px 9px;
  }

  .step-grid{
    grid-template-columns:1fr 1fr;
  }

  .calc{
    padding:14px;
  }

  .calc-left h2{
    font-size:24px;
  }

  .calc-photo{
    height:130px;
  }

  .fields{
    grid-template-columns:1fr 1fr;
  }

  .field:last-of-type{
    grid-column:1/-1;
  }

  .foot{
    display:block;
  }

  .foot div+div{
    margin-top:6px;
  }
}
</style>
</head>


